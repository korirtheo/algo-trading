# Copy this file to `.env` (gitignored) and fill in your real keys.
# NEVER commit .env. Secrets are read from env vars / .env only.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
TRADIER_API_KEY=

# Optional Alpaca MCP v2 operator/control plane.
# The Compose service is disabled unless started with --profile agent.
# Keep trading/locates out until explicit paper/live operator controls are added.
ALPACA_MCP_TOOLSETS=account,assets,stock-data,news,corporate-actions

# Polygon (optional, download scripts only; _2/_3/_4 = parallel quarterly keys)
POLYGON_API_KEY=
POLYGON_API_KEY_2=
POLYGON_API_KEY_3=
POLYGON_API_KEY_4=
